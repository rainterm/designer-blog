# =====================================================================
# Designer Admin 生产环境变量模板
# 使用：cp .env.example .env 后按需修改
#   ./deploy-db.sh   # 仅 MySQL + Redis
#   ./deploy-app.sh  # 构建部署 Server + 前端（博客前台 / 管理后台）
# =====================================================================

# ---- 对外访问（应用）----
# 前端 Nginx 宿主机端口。同一容器内按域名分流：
#   www.rainterm.cn   → 博客前台
#   admin.rainterm.cn → 管理后台
# 域名在 deploy/nginx/default.conf 的 server_name 中定义，改域名只需改那一处
WEB_PORT=80
# 后端 API 宿主机端口（直连 http://服务器IP:SERVER_PORT ，容器内仍为 8080）
SERVER_PORT=8080

# ---- 数据库基础设施（./deploy-db.sh）----
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=designer_blog
MYSQL_USER=designer
MYSQL_PASSWORD=123456
# 宿主机映射端口
MYSQL_PORT=3306

REDIS_PASSWORD=123456
REDIS_PORT=6379

# ---- MinIO（docker-compose.minio.yml）----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- 应用连接库（./deploy-app.sh）----
# 本机 Docker 部署的库：用 host.docker.internal 访问宿主机已映射端口
# 外部云数据库：改为真实地址，如 10.0.0.12 或 rm-xxx.mysql.rds.aliyuncs.com
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=designer_blog
DB_USER=designer
# 与 MYSQL_ROOT_PASSWORD 保持一致（使用本机 deploy-db 时）
DB_PASSWORD=123456

REDIS_HOST=host.docker.internal
# 与上方 REDIS_PORT / REDIS_PASSWORD 一致（使用本机 deploy-db 时）
REDIS_DB=5

# ---- 后端 JVM（可选）----
JAVA_OPTS="-Xms512m -Xmx1024m -Dfile.encoding=UTF-8"

# ---- 镜像 / 项目名 ----
IMAGE_TAG=1.0.0
COMPOSE_PROJECT_NAME=designer-admin
